# Your Space's Caddy configuration (research R9; journey 002's plan, "The access gate"). The mode file
# Compose picks (deploy/modes/) sets:
#   YS_SITE           Your Space's own site: http://space.localhost, https://<YS_DOMAIN>, or http://:8080
#   YS_APPS_SITE      the apps' site: http://*.space.localhost or https://*.<YS_DOMAIN>
#   YS_APPS_TLS       on_demand for your own domain, so each installed app gets its own certificate
#   YS_ORIGIN         Your Space's origin, the only page allowed to frame an app
#   YS_REDIRECT_SITES addresses that redirect to Your Space, such as http://localhost
#   YS_REDIRECT_URL   where they redirect: sign-in works at one address only
# Behind your own proxy, YS_PROXY_URL names Your Space's address, and every other name on port 8080
# goes to the access gate. Names under Your Space's are the apps'; the gate answers any other name,
# which a proxy that rewrites the Host header sends, with 421 and what to fix.
{
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
	servers :8080 {
		# Only port 8080, where your own proxy forwards, accepts the visitor address a proxy reports.
		# Strict mode reads X-Forwarded-For from the right and skips private addresses as proxies, so
		# the proxy must replace the header with the visitor's address. If it appended to it instead
		# (nginx's $proxy_add_x_forwarded_for), a visitor on the local network could put a made-up
		# address in front of their own (docs/install/other-devices.md).
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
	# On your own domain, a certificate is requested only for names the server says are Your
	# Space's or an installed app's.
	on_demand_tls {
		ask http://server:3001/tls-ask
	}
}

(app) {
	encode

	handle /api/* {
		# API requests are small. The server reads auth request bodies whole, so cap them here.
		request_body {
			max_size 64KB
		}
		# Caddy passes the Host header through unchanged; the server checks it.
		reverse_proxy server:3000 {
			# A single client address, the form Better Auth's sign-in limit reads.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# There is no `log` directive, so the access log stays off and request URLs are not recorded.
}

# An app's address. The gate lets a request through only with the owner's pass and names where the
# app's interface is; the app never sees Your Space's cookies or the pass, its cookies stay on its
# own host, and only Your Space can frame it (FR-014, FR-014a, FR-017).
(apps) {
	# Only the gate names the upstream.
	request_header -X-YS-Upstream

	handle /__ys/handoff {
		rewrite * /handoff?{query}
		reverse_proxy server:3001
	}

	handle {
		forward_auth server:3001 {
			uri /gate
			header_up X-Forwarded-For {client_ip}
			copy_headers X-YS-Upstream
		}
		reverse_proxy {http.request.header.X-YS-Upstream} {
			header_up -X-YS-Upstream
			header_up Cookie "^(__Host-)?ys-pass=[^;]*;?\s*" ""
			header_up Cookie ";\s*(__Host-)?ys-pass=[^;]*" ""
			header_down -X-Frame-Options
			header_down Content-Security-Policy "frame-ancestors[^;]*" "frame-ancestors {$YS_ORIGIN}"
			header_down +Content-Security-Policy "frame-ancestors {$YS_ORIGIN}"
			header_down Set-Cookie "(?i);\s*domain=[^;]*" ""
		}
	}
}

(apps_tls_none) {
}

(apps_tls_on_demand) {
	tls {
		on_demand
	}
}

{$YS_SITE:http://space.localhost} {
	# Behind your own proxy, every name other than Your Space's own goes to the gate, which serves
	# the apps' names and answers any other name with 421.
	@app_host expression `"{$YS_PROXY_URL}" != "" && "{$YS_PROXY_URL}" != "https://" + {http.request.hostport}`
	handle @app_host {
		import apps
	}
	handle {
		import app
	}
}

{$YS_APPS_SITE:http://*.space.localhost} {
	import apps_tls_{$YS_APPS_TLS:none}
	import apps
}

{$YS_REDIRECT_SITES:http://127.0.0.1} {
	redir {$YS_REDIRECT_URL:http://space.localhost}{uri}
}

# Private server-to-app dispatch. The volume is mounted only by the server and edge.
http://:3099 {
	bind unix//run/ys-agent/edge.sock|0666
	reverse_proxy {http.request.header.X-YS-Target} {
		header_up -X-YS-Target
	}
}

# Your Space settings. Copy this file to .env next to compose.yaml. Never commit .env or share it:
# it holds the secrets below.

# Secrets. Generate each one; do not reuse them.
#   BETTER_AUTH_SECRET: openssl rand -base64 32
#   POSTGRES_PASSWORD:  openssl rand -hex 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# Everything below is optional. With none of it, Your Space runs on this machine only, at
# http://localhost. To use it from other devices, remove the # from one of these lines and change
# the value (see the installation guide).

# Your own domain. Its DNS must point at this server, with ports 80 and 443 open to the internet.
# Caddy gets and renews the certificate.
# YS_DOMAIN=space.example.com

# Your own proxy or Tailscale, which serves HTTPS at this address and forwards to 127.0.0.1:8080.
# YS_PROXY_URL=https://myserver.tail1234.ts.net

# A different local port, when another program already uses 80 (or 8080 with YS_PROXY_URL).
# YS_PORT=8081

# Another release's images. Leave it out to run the release these files came with.
# YS_VERSION=

# Your Space settings. Copy this file to .env next to compose.yaml and fill it in.
# Never commit .env or share it: it holds the secrets below.

# The address people use to reach Your Space.
#   This machine only (default):  YS_PUBLIC_URL=http://localhost
#   Your own domain:              YS_PUBLIC_URL=https://space.example.com
#     Caddy gets and renews a certificate automatically. DNS must point at this host, with
#     ports 80 and 443 open to the internet.
#   Your own proxy or Tailscale:  YS_PUBLIC_URL=https://<the proxy's address>
#     and also set YS_SITE_ADDRESS=http://:8080 (and YS_TRUSTED_PROXIES=private_ranges) below.
# Plain http:// works only for localhost: other devices need HTTPS.
YS_PUBLIC_URL=http://localhost

# Only for your own proxy or Tailscale: Caddy serves plain HTTP on 127.0.0.1:8080 and the proxy
# handles HTTPS.
# YS_SITE_ADDRESS=http://:8080
# YS_TRUSTED_PROXIES=private_ranges

# Secrets. Generate each one; do not reuse them.
#   BETTER_AUTH_SECRET: openssl rand -base64 32
#   POSTGRES_PASSWORD:  openssl rand -hex 32
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=

# The image version to run. Leave unset for the latest release.
# YS_VERSION=

# Your Space settings. Copy this file to .env next to compose.yaml. Every line is optional: with
# none of them, Your Space runs on this machine only, at http://localhost, and generates its own
# secrets on the first start. To change something, remove the # from a line and edit its value
# (see the installation guide).

# Your own domain. Its DNS must point at this server, with ports 80 and 443 open to the internet.
# Caddy gets and renews the certificate.
# YS_DOMAIN=space.example.com

# Your own proxy or Tailscale, which serves HTTPS at this address and forwards to 127.0.0.1:8080.
# YS_PROXY_URL=https://myserver.tail1234.ts.net

# A different local port, when another program already uses 80 (or 8080 with YS_PROXY_URL).
# YS_PORT=8081

# Your own secrets, for example from a password manager, instead of generated ones. Used as given
# and never copied. Set them before the first start: the database keeps the password it was
# created with. See them with: docker compose exec server show-secrets
# BETTER_AUTH_SECRET=
# POSTGRES_PASSWORD=

# Another release's images. Leave it out to run the release these files came with.
# YS_VERSION=

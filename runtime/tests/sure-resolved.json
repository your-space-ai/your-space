{
  "name": "ys-sure",
  "networks": {
    "sure_net": {
      "name": "ys-sure_sure_net",
      "driver": "bridge",
      "ipam": {}
    }
  },
  "services": {
    "db": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "sure_production",
        "POSTGRES_PASSWORD": "sure_password",
        "POSTGRES_USER": "sure_user"
      },
      "image": "postgres:16",
      "networks": {
        "sure_net": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "postgres-data",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U $$POSTGRES_USER -d $$POSTGRES_DB"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 5
      }
    },
    "redis": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "image": "redis:latest",
      "networks": {
        "sure_net": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "redis-data",
          "target": "/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 5
      }
    },
    "web": {
      "restart": "unless-stopped",
      "command": null,
      "dns": [
        "8.8.8.8",
        "1.1.1.1"
      ],
      "entrypoint": null,
      "environment": {
        "AI_HEALTH_PROBE_CACHE_TTL": "",
        "AI_HEALTH_PROBE_TIMEOUT": "",
        "AI_RESPONSE_TIMEOUT": "90",
        "ASSISTANT_MAX_TOOL_CALL_ITERATIONS": "",
        "DB_HOST": "db",
        "DB_PORT": "5432",
        "LLM_CONTEXT_WINDOW": "",
        "OPENAI_ACCESS_TOKEN": "",
        "OPENAI_MODEL": "",
        "OPENAI_REQUEST_TIMEOUT": "60",
        "OPENAI_URI_BASE": "",
        "POSTGRES_DB": "sure_production",
        "POSTGRES_PASSWORD": "sure_password",
        "POSTGRES_USER": "sure_user",
        "RAILS_ASSUME_SSL": "false",
        "RAILS_FORCE_SSL": "false",
        "REDIS_URL": "redis://redis:6379/1",
        "SECRET_KEY_BASE": "a7523c3d0ae56415046ad8abae168d71074a79534a7062258f8d1d51ac2f76d3c3bc86d86b6b0b307df30d9a6a90a2066a3fa9e67c5e6f374dbd7dd4e0778e13",
        "SELF_HOSTED": "true"
      },
      "image": "ghcr.io/we-promise/sure:stable",
      "networks": {
        "sure_net": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "app-storage",
          "target": "/rails/storage",
          "volume": {}
        }
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 3000,
          "published": "3000",
          "protocol": "tcp"
        }
      ]
    },
    "worker": {
      "restart": "unless-stopped",
      "command": [
        "bundle",
        "exec",
        "sidekiq"
      ],
      "dns": [
        "8.8.8.8",
        "1.1.1.1"
      ],
      "entrypoint": null,
      "environment": {
        "AI_HEALTH_PROBE_CACHE_TTL": "",
        "AI_HEALTH_PROBE_TIMEOUT": "",
        "AI_RESPONSE_TIMEOUT": "90",
        "ASSISTANT_MAX_TOOL_CALL_ITERATIONS": "",
        "DB_HOST": "db",
        "DB_PORT": "5432",
        "LLM_CONTEXT_WINDOW": "",
        "OPENAI_ACCESS_TOKEN": "",
        "OPENAI_MODEL": "",
        "OPENAI_REQUEST_TIMEOUT": "60",
        "OPENAI_URI_BASE": "",
        "POSTGRES_DB": "sure_production",
        "POSTGRES_PASSWORD": "sure_password",
        "POSTGRES_USER": "sure_user",
        "RAILS_ASSUME_SSL": "false",
        "RAILS_FORCE_SSL": "false",
        "REDIS_URL": "redis://redis:6379/1",
        "SECRET_KEY_BASE": "a7523c3d0ae56415046ad8abae168d71074a79534a7062258f8d1d51ac2f76d3c3bc86d86b6b0b307df30d9a6a90a2066a3fa9e67c5e6f374dbd7dd4e0778e13",
        "SELF_HOSTED": "true"
      },
      "image": "ghcr.io/we-promise/sure:stable",
      "networks": {
        "sure_net": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "app-storage",
          "target": "/rails/storage",
          "volume": {}
        }
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        },
        "redis": {
          "condition": "service_healthy",
          "required": true
        }
      }
    }
  },
  "volumes": {
    "app-storage": {
      "name": "ys-sure_app-storage"
    },
    "postgres-data": {
      "name": "ys-sure_postgres-data"
    },
    "redis-data": {
      "name": "ys-sure_redis-data"
    }
  },
  "x-db-env": {
    "POSTGRES_DB": "sure_production",
    "POSTGRES_PASSWORD": "sure_password",
    "POSTGRES_USER": "sure_user"
  },
  "x-rails-env": {
    "AI_HEALTH_PROBE_CACHE_TTL": "",
    "AI_HEALTH_PROBE_TIMEOUT": "",
    "AI_RESPONSE_TIMEOUT": "90",
    "ASSISTANT_MAX_TOOL_CALL_ITERATIONS": "",
    "DB_HOST": "db",
    "DB_PORT": 5432,
    "LLM_CONTEXT_WINDOW": "",
    "OPENAI_ACCESS_TOKEN": "",
    "OPENAI_MODEL": "",
    "OPENAI_REQUEST_TIMEOUT": "60",
    "OPENAI_URI_BASE": "",
    "POSTGRES_DB": "sure_production",
    "POSTGRES_PASSWORD": "sure_password",
    "POSTGRES_USER": "sure_user",
    "RAILS_ASSUME_SSL": "false",
    "RAILS_FORCE_SSL": "false",
    "REDIS_URL": "redis://redis:6379/1",
    "SECRET_KEY_BASE": "a7523c3d0ae56415046ad8abae168d71074a79534a7062258f8d1d51ac2f76d3c3bc86d86b6b0b307df30d9a6a90a2066a3fa9e67c5e6f374dbd7dd4e0778e13",
    "SELF_HOSTED": "true"
  }
}